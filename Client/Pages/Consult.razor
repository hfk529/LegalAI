@page "/consult"
@using MudBlazor
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center">
            ⚖️ 智能法律咨询助手
        </MudText>
        <MudDivider Class="my-4" />

        <MudAlert Severity="Severity.Info" Class="mb-4">
            本系统由 AI 生成，仅供参考，<strong>不构成律师意见</strong>。重大案件请咨询持证律师。
        </MudAlert>

        <MudTextField @bind-Value="userQuestion"
                      Label="请输入您的法律问题（例如：公司拖欠工资怎么办？）"
                      Lines="4"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.QuestionAnswer"
                      @onkeydown="OnKeyDown"
                      Disabled="@isThinking" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="AskAI"
                   Disabled="@isThinking">
            @if (isThinking)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>咨询中...</span>
            }
            else
            {
                <span>提交咨询</span>
            }
        </MudButton>

        @if (isThinking)
        {
            <MudProgressCircular Class="ml-4" Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.caption" Class="ml-2">AI 正在分析...</MudText>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" CloseIcon="@Icons.Material.Filled.Close" @onclose="error = null">
                @error
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(aiResponse))
        {
            <MudPaper Class="mt-6 pa-4" Elevation="2" Outlined="true">
                <MudText Typo="Typo.h6">AI 回答：</MudText>
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body1" Class="white-space-pre-wrap">@aiResponse</MudText>

                @if (sources.Any())
                {
                    <MudDivider Class="my-3" />
                    <MudText Color="Color.Info" Typo="Typo.caption">
                        📚 依据来源：@string.Join("； ", sources)
                    </MudText>
                }

                <MudButton Color="Color.Secondary"
                           Variant="Variant.Text"
                           Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Article"
                           @onclick="ShowComplaintForm"
                           Disabled="@isGenerating">
                    📄 生成起诉状
                </MudButton>

                @if (showComplaintForm)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1">填写起诉状要素</MudText>

                    <MudTextField @bind-Value="plaintiff" Label="原告（当事人）" Variant="Variant.Outlined" Class="mt-2" />
                    <MudTextField @bind-Value="defendant" Label="被告（当事人）" Variant="Variant.Outlined" Class="mt-2" />
                    <MudTextField @bind-Value="court" Label="受理法院（如：某某人民法院）" Variant="Variant.Outlined" Class="mt-2" />
                    <MudTextField @bind-Value="caseCause" Label="案由（例如：合同纠纷）" Variant="Variant.Outlined" Class="mt-2" />
                    <MudTextField @bind-Value="claimAmount" Label="诉讼请求（金额/简要诉求）" Variant="Variant.Outlined" Class="mt-2" />
                    <MudTextField @bind-Value="facts" Label="事实经过（尽量简洁，必要时分段）" Lines="6" Variant="Variant.Outlined" Class="mt-2" />

                    <div class="mt-3">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateComplaintAsync" Disabled="@isGenerating">
                            @if (isGenerating)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <span>生成中...</span>
                            }
                            else
                            {
                                <span>生成起诉状</span>
                            }
                        </MudButton>

                        <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="ml-2" OnClick="CancelComplaintForm">取消</MudButton>
                    </div>
                }

                @if (!string.IsNullOrEmpty(complaintResult))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.h6">生成的起诉状：</MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body1" Class="white-space-pre-wrap">@complaintResult</MudText>

                    <div class="mt-3">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CopyComplaint">复制到剪贴板</MudButton>
                        <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="ml-2" OnClick="CancelComplaintForm">关闭</MudButton>
                    </div>
                }

            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {
    private string userQuestion = "";
    private string aiResponse = "";
    private List<string> sources = new();
    private bool isThinking = false;
    private bool isGenerating = false;
    private string? error = null;

    // 起诉状表单字段
    private bool showComplaintForm = false;
    private string plaintiff = "";
    private string defendant = "";
    private string court = "";
    private string caseCause = "";
    private string claimAmount = "";
    private string facts = "";
    private string complaintResult = "";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
            await AskAI();
    }

    private async Task AskAI()
    {
        if (string.IsNullOrWhiteSpace(userQuestion))
        {
            error = "请输入您的问题";
            return;
        }

        isThinking = true;
        error = null;
        aiResponse = "";
        sources = new();

        try
        {
            var request = new AIRequest
                {
                    Question = userQuestion
                };

            var response = await Http.PostAsJsonAsync("api/AI/consult", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AIResponse>();
                if (result?.IsError == true)
                {
                    error = result.ErrorMessage;
                }
                else
                {
                    aiResponse = result?.Answer ?? "";
                    sources = result?.Sources ?? new();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                error = "请求过于频繁，请稍后再试";
            }
            else
            {
                error = $"请求失败：{(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (System.Net.Http.HttpRequestException httpEx)
        {
            error = $"网络错误：{httpEx.Message}";
        }
        catch (System.Exception ex)
        {
            error = "系统异常，请稍后再试";
            Console.Error.WriteLine($"AI 请求异常: {ex}");
        }
        finally
        {
            isThinking = false;
        }
    }

    private void ShowComplaintForm()
    {
        showComplaintForm = true;
        complaintResult = "";
        // 预填充一些字段，方便用户
        if (string.IsNullOrWhiteSpace(plaintiff)) plaintiff = "原告姓名/公司名称";
        if (string.IsNullOrWhiteSpace(defendant)) defendant = "被告姓名/公司名称";
        if (string.IsNullOrWhiteSpace(caseCause)) caseCause = "合同纠纷";
    }

    private void CancelComplaintForm()
    {
        showComplaintForm = false;
    }

    private async Task GenerateComplaintAsync()
    {
        // 简单校验
        if (string.IsNullOrWhiteSpace(plaintiff) || string.IsNullOrWhiteSpace(defendant) || string.IsNullOrWhiteSpace(facts))
        {
            error = "请填写原告、被告和事实经过等必要信息";
            return;
        }

        isGenerating = true;
        error = null;
        complaintResult = "";

        try
        {
            // 将表单要素拼接为清晰的案情描述，发送给后端生成起诉状
            var promptBuilder = new System.Text.StringBuilder();
            promptBuilder.AppendLine($"受理法院：{court}");
            promptBuilder.AppendLine($"原告：{plaintiff}");
            promptBuilder.AppendLine($"被告：{defendant}");
            promptBuilder.AppendLine($"案由：{caseCause}");
            promptBuilder.AppendLine($"诉讼请求：{claimAmount}");
            promptBuilder.AppendLine();
            promptBuilder.AppendLine("事实经过：");
            promptBuilder.AppendLine(facts);

            var request = new AIRequest
            {
                Question = promptBuilder.ToString(),
                Context = "请根据以下要素生成一份结构清晰、格式规范的民事起诉状，包含：起诉状标题、当事人基本信息、事实与理由、证据、诉讼请求、落款和送达信息。使用正式法律文书语言。"
            };

            var response = await Http.PostAsJsonAsync("api/AI/generate/complaint", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AIResponse>();
                if (result?.IsError == true)
                {
                    error = result.ErrorMessage;
                }
                else
                {
                    complaintResult = result?.Answer ?? "";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                error = "请求过于频繁，请稍后再试";
            }
            else
            {
                error = $"文书生成失败：{(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (System.Net.Http.HttpRequestException httpEx)
        {
            error = $"网络错误：{httpEx.Message}";
        }
        catch (System.Exception ex)
        {
            error = "系统异常，生成失败";
            Console.Error.WriteLine($"文书生成异常: {ex}");
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task CopyComplaint()
    {
        if (string.IsNullOrEmpty(complaintResult))
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", complaintResult);
            await JSRuntime.InvokeVoidAsync("alert", "已复制到剪贴板");
        }
        catch
        {
            await JSRuntime.InvokeVoidAsync("alert", "复制失败，请手动复制文书内容");
        }
    }
}