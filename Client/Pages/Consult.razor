@page "/consult"
@using MudBlazor
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center">
            ⚖️ 智能法律咨询助手
        </MudText>
        <MudDivider Class="my-4" />

        <MudAlert Severity="Severity.Info" Class="mb-4">
            本系统由 AI 生成，仅供参考，<strong>不构成律师意见</strong>。重大案件请咨询持证律师。
        </MudAlert>

        <MudTextField @bind-Value="userQuestion"
                      Label="请输入您的法律问题（例如：公司拖欠工资怎么办？）"
                      Lines="4"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.QuestionAnswer"
                      @onkeydown="OnKeyDown"
                      Disabled="@isThinking" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="AskAI"
                   Disabled="@isThinking">
            @if (isThinking)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>咨询中...</span>
            }
            else
            {
                <span>提交咨询</span>
            }
        </MudButton>

        @if (isThinking)
        {
            <MudProgressCircular Class="ml-4" Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.caption" Class="ml-2">AI 正在分析...</MudText>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" CloseIcon="@Icons.Material.Filled.Close" @onclose="error = null">
                @error
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(aiResponse))
        {
            <MudPaper Class="mt-6 pa-4" Elevation="2" Outlined="true">
                <MudText Typo="Typo.h6">AI 回答：</MudText>
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body1" Class="white-space-pre-wrap">@aiResponse</MudText>

                @if (sources.Any())
                {
                    <MudDivider Class="my-3" />
                    <MudText Color="Color.Info" Typo="Typo.caption">
                        📚 依据来源：@string.Join("； ", sources)
                    </MudText>
                }

                <MudButton Color="Color.Secondary"
                           Variant="Variant.Text"
                           Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Article"
                           @onclick="GenerateDocument"
                           Disabled="@isGenerating">
                    📄 生成起诉状（开发中）
                </MudButton>
            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {
    private string userQuestion = "";
    private string aiResponse = "";
    private List<string> sources = new();
    private bool isThinking = false;
    private bool isGenerating = false;
    private string? error = null;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
            await AskAI();
    }

    private async Task AskAI()
    {
        if (string.IsNullOrWhiteSpace(userQuestion))
        {
            error = "请输入您的问题";
            return;
        }

        isThinking = true;
        error = null;
        aiResponse = "";
        sources = new();

        try
        {
            var request = new AIRequest
                {
                    Question = userQuestion
                };

            var response = await Http.PostAsJsonAsync("api/AI/consult", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AIResponse>();
                if (result?.IsError == true)
                {
                    error = result.ErrorMessage;
                }
                else
                {
                    aiResponse = result?.Answer ?? "";
                    sources = result?.Sources ?? new();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                error = "请求过于频繁，请稍后再试";
            }
            else
            {
                error = $"请求失败：{(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (System.Net.Http.HttpRequestException httpEx)
        {
            error = $"网络错误：{httpEx.Message}";
        }
        catch (System.Exception ex)
        {
            error = "系统异常，请稍后再试";
            Console.Error.WriteLine($"AI 请求异常: {ex}");
        }
        finally
        {
            isThinking = false;
        }
    }

    private async Task GenerateDocument()
    {
        isGenerating = true;
        await Task.Delay(1000); // 模拟生成过程
        await JSRuntime.InvokeVoidAsync("alert", "文书生成功能开发中，敬请期待！");
        isGenerating = false;
    }
}